{
  "name": "obsidian-lotus",
  "version": "1.2.3",
  "description": "Obsidian plugin for running normal fenced code blocks with native syntax highlighting.",
  "author": "James Karlsson and Thomas Goldman",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node esbuild.config.mjs --production",
    "build:strict": "tsc -p tsconfig.json --noEmit && node esbuild.config.mjs --compile-mode=strict --production",
    "build:light": "tsc -p tsconfig.json --noEmit && node esbuild.config.mjs --compile-mode=light --production",
    "build:dev": "tsc -p tsconfig.json --noEmit && node esbuild.config.mjs --sourcemap",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:dynamic-inputs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/dynamic-inputs.test.mjs",
    "test:managed-output": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/managed-output.test.mjs",
    "test:engine": "node scripts/engine-smoke.mjs",
    "lint": "eslint --quiet src scripts language-packs esbuild.config.mjs manifest.json LICENSE",
    "smoke": "node scripts/smoke.mjs",
    "smoke:matrix": "npm run smoke -- --profile minimal && npm run smoke -- --profile systems && npm run smoke -- --profile proofs && npm run smoke -- --profile ebpf && npm run smoke -- --profile full",
    "smoke:pdf": "node scripts/smoke.mjs --require-pdf",
    "verify:signatures": "node scripts/verify-signatures.mjs"
  },
  "devDependencies": {
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.6",
    "@eslint/js": "^9.39.4",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.15.30",
    "@typescript-eslint/parser": "^8.62.0",
    "esbuild": "^0.25.6",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "^14.0.0",
    "obsidian": "^1.6.5",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "d3": "^7.9.0",
    "elkjs": "^0.10.2",
    "jsxgraph": "^1.12.2",
    "jszip": "^3.10.1"
  }
}
